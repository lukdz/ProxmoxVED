#!/usr/bin/env bash

# Shared Cloud-Init setup for Ubuntu cloud-image VM scripts.

if ! declare -f setup_cloud_init >/dev/null 2>&1; then
  _ubuntu_core_dir="${COMMUNITY_SCRIPTS_CORE_DIR:-$(dirname "${BASH_SOURCE[0]}")/../../core}"
  if [[ -f "${_ubuntu_core_dir}/vm/cloud-init.func" ]]; then
    source "${_ubuntu_core_dir}/vm/cloud-init.func"
  else
    source <(curl -fsSL "${COMMUNITY_SCRIPTS_CORE_URL:-https://raw.githubusercontent.com/community-scripts/core/main}/vm/cloud-init.func")
  fi
  unset _ubuntu_core_dir
fi

ubuntu_vmid_has_storage_volume() {
  local vmid="$1"
  local storage

  while IFS= read -r storage; do
    [[ -n "$storage" ]] || continue
    if pvesm list "$storage" 2>/dev/null | awk -v vmid="$vmid" \
      'NR > 1 && ($1 ~ ("vm-" vmid "-disk-[0-9]+") || $5 == vmid) {found=1} END {exit !found}'; then
      return 0
    fi
  done < <(pvesm status -content images 2>/dev/null | awk 'NR > 1 {print $1}')

  if command -v zfs >/dev/null 2>&1 && zfs list -H -t volume -o name 2>/dev/null |
    awk -v vmid="$vmid" '$0 ~ ("/vm-" vmid "-disk-[0-9]+(\\.|$)") {found=1} END {exit !found}'; then
    return 0
  fi
  return 1
}

ubuntu_get_valid_nextid() {
  local try_id

  try_id=$(pvesh get /cluster/nextid)
  while true; do
    if [[ -f "/etc/pve/qemu-server/${try_id}.conf" ]] ||
      [[ -f "/etc/pve/lxc/${try_id}.conf" ]] ||
      lvs --noheadings -o lv_name 2>/dev/null | grep -qE "(^|[-_])${try_id}($|[-_])" ||
      ubuntu_vmid_has_storage_volume "$try_id"; then
      try_id=$((try_id + 1))
      continue
    fi
    echo "$try_id"
    return 0
  done
}

ubuntu_configure_storage_layout() {
  local storage_type="$1"
  local storage_name="${2:-}"

  if [[ "$storage_name" == "local-zfs" || "$storage_type" == "zfspool" ]]; then
    DISK_EXT=""
    DISK_REF=""
    DISK_IMPORT="-format raw"
    FORMAT=",efitype=4m"
    THIN=""
  elif [[ "$storage_type" == "btrfs" ]]; then
    DISK_EXT=".raw"
    DISK_REF="$VMID/"
    DISK_IMPORT="-format raw"
    FORMAT=",efitype=4m"
    THIN=""
  elif [[ "$storage_type" == "nfs" || "$storage_type" == "dir" || "$storage_type" == "cifs" ]]; then
    DISK_EXT=".qcow2"
    DISK_REF="$VMID/"
    DISK_IMPORT="-format qcow2"
    THIN=""
  else
    DISK_EXT=""
    DISK_REF=""
    DISK_IMPORT="-format raw"
  fi
}

ubuntu_validate_cloud_init_user() {
  local user="$1"
  [[ "$user" =~ ^[a-z_][a-z0-9_-]*$ ]] && [[ "${#user}" -le 32 ]]
}

ubuntu_validate_ssh_key_file() {
  local key_file="$1"
  local key
  local extracted_key
  local key_count=0

  command -v ssh-keygen >/dev/null 2>&1 || return 1
  while IFS= read -r key || [[ -n "$key" ]]; do
    key="${key%$'\r'}"
    [[ -z "${key//[[:space:]]/}" || "$key" == \#* ]] && continue
    extracted_key=$(printf '%s\n' "$key" | awk '{for (i = 1; i <= NF; i++) if ($i ~ /^(ssh-(rsa|ed25519|dss|ecdsa)|ecdsa-sha2-)/) {print substr($0, index($0, $i)); exit}}')
    [[ -n "$extracted_key" ]] || return 1
    printf '%s\n' "$extracted_key" | ssh-keygen -lf - >/dev/null 2>&1 || return 1
    key_count=$((key_count + 1))
  done <"$key_file"
  [[ "$key_count" -gt 0 ]]
}

ubuntu_normalize_ssh_key_file() {
  local key_file="$1"
  local normalized_file="${key_file}.normalized"
  local key
  local extracted_key

  : >"$normalized_file"
  while IFS= read -r key || [[ -n "$key" ]]; do
    key="${key%$'\r'}"
    [[ -z "${key//[[:space:]]/}" || "$key" == \#* ]] && continue
    extracted_key=$(printf '%s\n' "$key" | awk '{for (i = 1; i <= NF; i++) if ($i ~ /^(ssh-(rsa|ed25519|dss|ecdsa)|ecdsa-sha2-)/) {print substr($0, index($0, $i)); exit}}')
    [[ -n "$extracted_key" ]] && printf '%s\n' "$extracted_key" >>"$normalized_file"
  done <"$key_file"
  mv -f "$normalized_file" "$key_file"
}

ubuntu_discover_host_ssh_keys() {
  local discovered_file="${TEMP_DIR:-/tmp}/cloud-init-host-sshkeys"
  local key_file
  local key

  : >"$discovered_file"
  for key_file in /root/.ssh/authorized_keys /root/.ssh/authorized_keys2 /root/.ssh/*.pub \
    /etc/ssh/authorized_keys /etc/ssh/authorized_keys.d/*; do
    [[ -f "$key_file" && -r "$key_file" ]] || continue
    while IFS= read -r key || [[ -n "$key" ]]; do
      key="${key%$'\r'}"
      [[ -z "${key//[[:space:]]/}" || "$key" == \#* ]] && continue
      printf '%s\n' "$key" >>"$discovered_file"
    done <"$key_file"
  done

  if [[ -s "$discovered_file" ]] && ubuntu_validate_ssh_key_file "$discovered_file"; then
    ubuntu_normalize_ssh_key_file "$discovered_file"
    printf '%s\n' "$discovered_file"
    return 0
  fi
  rm -f "$discovered_file"
  return 1
}

ubuntu_select_host_ssh_keys() {
  local key_file
  local key
  local extracted_key
  local key_type
  local key_blob
  local key_comment
  local fingerprint
  local selection
  local tag
  local key_index
  local selected_count=0
  local selected_file="${TEMP_DIR:-/tmp}/cloud-init-sshkeys"
  local -a key_files=()
  local -a keys=()
  local -a choices=()

  if [[ "$#" -gt 0 ]]; then
    key_files=("$@")
  else
    for key_file in /root/.ssh/authorized_keys /root/.ssh/authorized_keys2 /root/.ssh/*.pub \
      /etc/ssh/authorized_keys /etc/ssh/authorized_keys.d/*; do
      [[ -f "$key_file" && -r "$key_file" ]] && key_files+=("$key_file")
    done
  fi

  for key_file in "${key_files[@]}"; do
    while IFS= read -r key || [[ -n "$key" ]]; do
      key="${key%$'\r'}"
      [[ -z "${key//[[:space:]]/}" || "$key" == \#* ]] && continue
      extracted_key=$(printf '%s\n' "$key" | awk '{for (i = 1; i <= NF; i++) if ($i ~ /^(ssh-(rsa|ed25519|dss|ecdsa)|ecdsa-sha2-)/) {print substr($0, index($0, $i)); exit}}')
      [[ -n "$extracted_key" ]] || continue
      printf '%s\n' "$extracted_key" | ssh-keygen -lf - >/dev/null 2>&1 || continue

      read -r key_type key_blob key_comment <<<"$extracted_key"
      [[ "$key_comment" == "$key_blob" ]] && key_comment=""
      fingerprint=$(printf '%s\n' "$extracted_key" | ssh-keygen -lf - 2>/dev/null | awk '{print $2}')
      keys+=("$extracted_key")
      key_index="K${#keys[@]}"
      choices+=("$key_index" "[$key_type] ${fingerprint:-unknown} ${key_comment:+$key_comment }- $(basename -- "$key_file")" "OFF")
    done <"$key_file"
  done

  if [[ "${#keys[@]}" -eq 0 ]]; then
    whiptail --backtitle "Proxmox VE Helper Scripts" --title "NO HOST SSH KEYS" \
      --msgbox "No valid public SSH keys were found on the Proxmox host." 8 64
    return 65
  fi

  if ! selection=$(whiptail --backtitle "Proxmox VE Helper Scripts" --title "SELECT PROXMOX HOST SSH KEYS" \
    --checklist "Select the public keys to copy into the VM." 20 110 10 "${choices[@]}" 3>&1 1>&2 2>&3); then
    return 1
  fi

  rm -f "$selected_file"
  : >"$selected_file"
  for tag in $selection; do
    tag="${tag%\"}"
    tag="${tag#\"}"
    key_index="${tag#K}"
    if [[ "$key_index" =~ ^[0-9]+$ ]] && [[ -n "${keys[$((key_index - 1))]:-}" ]]; then
      printf '%s\n' "${keys[$((key_index - 1))]}" >>"$selected_file"
      selected_count=$((selected_count + 1))
    fi
  done

  if [[ "$selected_count" -eq 0 ]]; then
    rm -f "$selected_file"
    CLOUDINIT_SSH_KEYS=""
    CLOUDINIT_SSH_KEYS_TEMP=""
    echo -e "${ROOTSSH:-${TAB:-  }[SSH]${TAB:-  }${CL:-}}${BOLD:-}${DGN:-}SSH Keys: ${BGN:-}none selected${CL:-}"
    return 0
  fi

  CLOUDINIT_SSH_KEYS="$selected_file"
  CLOUDINIT_SSH_KEYS_TEMP="$selected_file"
  chmod 600 "$selected_file"
  echo -e "${ROOTSSH:-${TAB:-  }[SSH]${TAB:-  }${CL:-}}${BOLD:-}${DGN:-}SSH Keys: ${BGN:-}${selected_count} selected${CL:-}"
}

ubuntu_configure_ssh_keys() {
  local key_source
  local key_value
  local key_file="${TEMP_DIR:-/tmp}/cloud-init-sshkeys"

  rm -f "$key_file"
  if key_source=$(whiptail --backtitle "Proxmox VE Helper Scripts" --title "SSH KEY" --menu \
    "Choose how to configure an SSH public key." 16 76 5 \
    "host" "Copy public keys from the Proxmox host" \
    "paste" "Paste an OpenSSH public key" \
    "url" "Download keys from an HTTPS URL (e.g. https://github.com/user.keys)" \
    "folder" "Read keys from a file, folder, or glob" \
    "none" "Do not configure an SSH key" 3>&1 1>&2 2>&3); then
    case "$key_source" in
    host)
      ubuntu_select_host_ssh_keys
      return $?
      ;;
    paste)
      if key_value=$(whiptail --backtitle "Proxmox VE Helper Scripts" --inputbox \
        "Paste an OpenSSH public key exactly as provided (ssh-ed25519, ssh-rsa, etc.)." \
        10 76 --title "PASTE SSH PUBLIC KEY" --cancel-button Exit-Script 3>&1 1>&2 2>&3); then
        [[ -n "$key_value" ]] || return 0
        printf '%s\n' "$key_value" >"$key_file"
      else
        return 1
      fi
      ;;
    url)
      if key_value=$(whiptail --backtitle "Proxmox VE Helper Scripts" --inputbox \
        "Enter an HTTPS URL returning one or more OpenSSH public keys." \
        10 76 --title "SSH KEY URL" --cancel-button Exit-Script 3>&1 1>&2 2>&3); then
        [[ "$key_value" =~ ^https://[^/[:space:]]+(/[^[:space:]]*)?$ ]] || {
          whiptail --backtitle "Proxmox VE Helper Scripts" --title "INVALID URL" \
            --msgbox "Only HTTPS URLs are supported for SSH key downloads." 8 58
          return 65
        }
        if ! curl -f#L --proto '=https' --proto-redir '=https' --max-time 30 --max-filesize 1048576 \
          --retry 2 -o "$key_file" "$key_value"; then
          whiptail --backtitle "Proxmox VE Helper Scripts" --title "SSH KEY DOWNLOAD FAILED" \
            --msgbox "Unable to download SSH keys from:\n\n$key_value" 10 70
          return 65
        fi
      else
        return 1
      fi
      ;;
    folder)
      if key_value=$(whiptail --backtitle "Proxmox VE Helper Scripts" --inputbox \
        "Enter a key file, folder, or glob (e.g. /root/.ssh/*.pub)." \
        10 72 --title "SSH KEY FILE" --cancel-button Exit-Script 3>&1 1>&2 2>&3); then
        local -a key_files=()
        local candidate
        shopt -s nullglob
        if [[ -d "$key_value" ]]; then
          key_files=("$key_value"/*.pub "$key_value"/authorized_keys "$key_value"/authorized_keys2)
        else
          key_files=($key_value)
        fi
        shopt -u nullglob
        for candidate in "${key_files[@]}"; do
          [[ -f "$candidate" ]] || continue
          while IFS= read -r key || [[ -n "$key" ]]; do
            key="${key%$'\r'}"
            [[ -z "${key//[[:space:]]/}" || "$key" == \#* ]] && continue
            printf '%s\n' "$key" >>"$key_file"
          done <"$candidate"
        done
      else
        return 1
      fi
      ;;
    none)
      return 0
      ;;
    esac
  else
    return 1
  fi

  if ! ubuntu_validate_ssh_key_file "$key_file"; then
    whiptail --backtitle "Proxmox VE Helper Scripts" --title "INVALID SSH KEY" \
      --msgbox "The input did not contain valid OpenSSH public keys." 8 70
    rm -f "$key_file"
    return 65
  fi
  ubuntu_normalize_ssh_key_file "$key_file"
  CLOUDINIT_SSH_KEYS="$key_file"
  CLOUDINIT_SSH_KEYS_TEMP="$key_file"
  chmod 600 "$key_file"
  echo -e "${ROOTSSH:-${TAB:-  }[SSH]${TAB:-  }${CL:-}}${BOLD:-}${DGN:-}SSH Keys: ${BGN:-}configured${CL:-}"
}

ubuntu_configure_cloud_init_credentials() {
  local password_confirm
  local key_status

  CLOUDINIT_SSH_KEYS_TEMP=""
  CLOUDINIT_HOST_KEY_FILE=""
  while true; do
    if CLOUDINIT_PASSWORD=$(whiptail --backtitle "Proxmox VE Helper Scripts" --passwordbox \
      "Set a password for ${CLOUDINIT_USER}. Leave blank for console-only access through Proxmox. A password is optional when an SSH key is configured in the next step." \
      10 70 --title "CLOUD-INIT PASSWORD" --cancel-button Exit-Script 3>&1 1>&2 2>&3); then
      if [[ -n "$CLOUDINIT_PASSWORD" ]]; then
        if password_confirm=$(whiptail --backtitle "Proxmox VE Helper Scripts" --passwordbox \
          "Confirm the Cloud-Init password." 8 70 --title "CONFIRM PASSWORD" --cancel-button Exit-Script 3>&1 1>&2 2>&3); then
          [[ "$CLOUDINIT_PASSWORD" == "$password_confirm" ]] || {
            whiptail --backtitle "Proxmox VE Helper Scripts" --title "PASSWORD MISMATCH" \
              --msgbox "The passwords do not match. Please try again." 8 58
            continue
          }
        else
          return 1
        fi
      fi
    else
      return 1
    fi

    CLOUDINIT_SSH_KEYS=""
    key_status=0
    ubuntu_configure_ssh_keys || key_status=$?
    [[ "$key_status" -eq 65 ]] && continue
    [[ "$key_status" -eq 0 ]] || return "$key_status"
    break
  done

  if [[ -n "${CLOUDINIT_SSH_KEYS:-}" ]]; then
    CLOUDINIT_SSH_PWAUTH="no"
    CLOUDINIT_ACCESS_MODE="ssh-key"
  elif [[ -n "$CLOUDINIT_PASSWORD" ]]; then
    CLOUDINIT_SSH_PWAUTH="yes"
    CLOUDINIT_ACCESS_MODE="password"
  else
    CLOUDINIT_SSH_PWAUTH="no"
    CLOUDINIT_ACCESS_MODE="console"
  fi
  export CLOUDINIT_PASSWORD CLOUDINIT_SSH_PWAUTH CLOUDINIT_ACCESS_MODE
}

ubuntu_configure_cloud_init_default() {
  CLOUDINIT_ENABLE="yes"
  USE_CLOUD_INIT="yes"
  CLOUDINIT_USER="ubuntu"
  CLOUDINIT_NETWORK_MODE="dhcp"
  CLOUDINIT_IP=""
  CLOUDINIT_GW=""
  CLOUDINIT_DNS=""
  CLOUDINIT_PASSWORD=""
  CLOUDINIT_SSH_KEYS_TEMP=""
  CLOUDINIT_HOST_KEY_FILE=""

  if ubuntu_discover_host_ssh_keys >/dev/null; then
    CLOUDINIT_SSH_KEYS="${TEMP_DIR:-/tmp}/cloud-init-host-sshkeys"
    CLOUDINIT_SSH_KEYS_TEMP="$CLOUDINIT_SSH_KEYS"
    CLOUDINIT_SSH_PWAUTH="no"
    CLOUDINIT_ACCESS_MODE="ssh-key"
    echo -e "${ROOTSSH:-${TAB:-  }[SSH]${TAB:-  }${CL:-}}${BOLD:-}${DGN:-}SSH Keys: ${BGN:-}host keys selected${CL:-}"
    echo -e "${CLOUD:-${TAB:-  }[Cloud-Init]${TAB:-  }${CL:-}}${BOLD:-}${DGN:-}Cloud-Init access: ${BGN:-}${CLOUDINIT_USER} with SSH key authentication${CL:-}"
  else
    CLOUDINIT_SSH_KEYS=""
    CLOUDINIT_SSH_PWAUTH="yes"
    CLOUDINIT_ACCESS_MODE="password"
    echo -e "${ROOTSSH:-${TAB:-  }[SSH]${TAB:-  }${CL:-}}${BOLD:-}${DGN:-}SSH Keys: ${BGN:-}none found${CL:-}"
    CLOUDINIT_PASSWORD=$(openssl rand -base64 16)
    echo -e "${CLOUD:-${TAB:-  }[Cloud-Init]${TAB:-  }${CL:-}}${BOLD:-}${DGN:-}Cloud-Init access: ${BGN:-}${CLOUDINIT_USER} with generated password${CL:-}"
  fi
  export CLOUDINIT_ENABLE USE_CLOUD_INIT CLOUDINIT_USER CLOUDINIT_NETWORK_MODE CLOUDINIT_IP \
    CLOUDINIT_GW CLOUDINIT_DNS CLOUDINIT_PASSWORD CLOUDINIT_SSH_PWAUTH CLOUDINIT_ACCESS_MODE
}

ubuntu_configure_cloud_init_advanced() {
  if ! whiptail --backtitle "Proxmox VE Helper Scripts" --title "CLOUD-INIT" \
    --yesno "Configure the VM with Cloud-Init?" 10 58; then
    CLOUDINIT_ENABLE="no"
    USE_CLOUD_INIT="no"
    export CLOUDINIT_ENABLE USE_CLOUD_INIT
    echo -e "${CLOUD:-${TAB:-  }[Cloud-Init]${TAB:-  }${CL:-}}${BOLD:-}${DGN:-}Cloud-Init: ${BGN:-}no${CL:-}"
    return 0
  fi

  CLOUDINIT_ENABLE="yes"
  USE_CLOUD_INIT="yes"
  export CLOUDINIT_ENABLE USE_CLOUD_INIT
  echo -e "${CLOUD:-${TAB:-  }[Cloud-Init]${TAB:-  }${CL:-}}${BOLD:-}${DGN:-}Cloud-Init: ${BGN:-}yes${CL:-}"

  while true; do
    if CLOUDINIT_USER=$(whiptail --backtitle "Proxmox VE Helper Scripts" --inputbox \
      "Set the Cloud-Init login username. A non-root user is recommended and will receive passwordless sudo." \
      10 70 "ubuntu" --title "CLOUD-INIT USER" --cancel-button Exit-Script 3>&1 1>&2 2>&3); then
      CLOUDINIT_USER="${CLOUDINIT_USER:-ubuntu}"
      if ubuntu_validate_cloud_init_user "$CLOUDINIT_USER"; then
        break
      fi
      whiptail --backtitle "Proxmox VE Helper Scripts" --title "INVALID USERNAME" \
        --msgbox "Use 1-32 lowercase letters, numbers, underscores, or hyphens. The first character must be a letter or underscore." 10 70
    else
      return 1
    fi
  done

  if whiptail --backtitle "Proxmox VE Helper Scripts" --title "NETWORK MODE" \
    --yesno "Use DHCP for network configuration?" 10 58; then
    CLOUDINIT_NETWORK_MODE="dhcp"
    CLOUDINIT_IP=""
    CLOUDINIT_GW=""
    CLOUDINIT_DNS=""
  else
    CLOUDINIT_NETWORK_MODE="static"
    while true; do
      if CLOUDINIT_IP=$(whiptail --backtitle "Proxmox VE Helper Scripts" --inputbox \
        "Static IP Address (CIDR format)\nExample: 192.168.1.100/24" 9 58 "" --title "IP ADDRESS" --cancel-button Exit-Script 3>&1 1>&2 2>&3); then
        validate_ip_cidr "$CLOUDINIT_IP" && break
        whiptail --backtitle "Proxmox VE Helper Scripts" --title "INVALID IP" \
          --msgbox "Please use CIDR format: x.x.x.x/xx" 8 58
      else
        return 1
      fi
    done
    while true; do
      if CLOUDINIT_GW=$(whiptail --backtitle "Proxmox VE Helper Scripts" --inputbox \
        "Gateway IP Address\nExample: 192.168.1.1" 8 58 "" --title "GATEWAY" --cancel-button Exit-Script 3>&1 1>&2 2>&3); then
        validate_ip "$CLOUDINIT_GW" && break
        whiptail --backtitle "Proxmox VE Helper Scripts" --title "INVALID GATEWAY" \
          --msgbox "Please use format: x.x.x.x" 8 58
      else
        return 1
      fi
    done
    if CLOUDINIT_DNS=$(whiptail --backtitle "Proxmox VE Helper Scripts" --inputbox \
      "DNS Servers (space-separated)" 8 58 "1.1.1.1 8.8.8.8" --title "DNS SERVERS" --cancel-button Exit-Script 3>&1 1>&2 2>&3); then
      CLOUDINIT_DNS="${CLOUDINIT_DNS:-1.1.1.1 8.8.8.8}"
    else
      return 1
    fi
  fi

  ubuntu_configure_cloud_init_credentials
}

ubuntu_ensure_virt_customize() {
  if ! command -v virt-customize >/dev/null 2>&1; then
    msg_info "Installing libguestfs-tools"
    ${STD:-} apt update >/dev/null 2>&1
    ${STD:-} apt install -y libguestfs-tools >/dev/null 2>&1
    msg_ok "Installed libguestfs-tools"
  fi
}

ubuntu_configure_image_access() {
  local image="$1"

  ubuntu_ensure_virt_customize
  if [[ "${CLOUDINIT_ENABLE:-no}" == "yes" && "${CLOUDINIT_ACCESS_MODE:-}" != "console" ]]; then
    virt-customize -q -a "$image" --run-command \
      "mkdir -p /etc/cloud/cloud.cfg.d && printf 'ssh_pwauth: ${CLOUDINIT_SSH_PWAUTH:-yes}\\n' > /etc/cloud/cloud.cfg.d/99-community-scripts-ssh-pwauth.cfg" \
      >/dev/null 2>&1
  else
    virt-customize -q -a "$image" --run-command 'mkdir -p /etc/systemd/system/serial-getty@ttyS0.service.d /etc/systemd/system/getty@tty1.service.d && cat > /etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf << "EOF"
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin root --noclear %I $TERM
EOF
cat > /etc/systemd/system/getty@tty1.service.d/autologin.conf << "EOF"
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin root --noclear %I $TERM
EOF' >/dev/null 2>&1
  fi
}

ubuntu_setup_cloud_init() {
  local selected_password="${CLOUDINIT_PASSWORD:-}"
  local mac_address="${1:-}"

  setup_cloud_init "$VMID" "$STORAGE" "$HN" "yes" "$CLOUDINIT_USER" \
    "$CLOUDINIT_NETWORK_MODE" "${CLOUDINIT_IP:-}" "${CLOUDINIT_GW:-}" "${CLOUDINIT_DNS:-}"

  CLOUDINIT_PASSWORD="$selected_password"
  if [[ -n "$selected_password" ]]; then
    qm set "$VMID" --cipassword "$selected_password" >/dev/null
  else
    qm set "$VMID" --delete cipassword >/dev/null 2>&1 || true
  fi
  if [[ "${CLOUDINIT_NETWORK_MODE:-dhcp}" == "dhcp" ]]; then
    qm set "$VMID" --delete nameserver >/dev/null 2>&1 || true
  elif [[ "${CLOUDINIT_NEEDS_NETWORK_NO_RENAME:-no}" == "yes" && -n "$mac_address" ]] && declare -f setup_cloud_init_network_no_rename >/dev/null 2>&1; then
    setup_cloud_init_network_no_rename \
      "$VMID" "$mac_address" "$CLOUDINIT_IP" "$CLOUDINIT_GW" \
      "$CLOUDINIT_DNS" "${CLOUDINIT_SEARCH_DOMAIN:-local}"
  fi

  CLOUDINIT_CRED_FILE="/tmp/${HN}-${VMID}-cloud-init-credentials.txt"
  local network_summary="DHCP"
  local dns_summary="provided by DHCP"
  local ssh_summary="ssh ${CLOUDINIT_USER}@<vm-ip>"
  if [[ "${CLOUDINIT_NETWORK_MODE:-dhcp}" == "static" ]]; then
    network_summary="static (IP: ${CLOUDINIT_IP}${CLOUDINIT_GW:+, GW: ${CLOUDINIT_GW}})"
    dns_summary="${CLOUDINIT_DNS:-not configured}"
  fi
  if [[ "${CLOUDINIT_ACCESS_MODE:-}" == "console" ]]; then
    ssh_summary="unavailable (no password or SSH key configured)"
  fi
  umask 077
  cat >"$CLOUDINIT_CRED_FILE" <<EOF
Cloud-Init Credentials
======================
VM ID:    ${VMID}
Hostname: ${HN}

Username: ${CLOUDINIT_USER}
Password: ${CLOUDINIT_PASSWORD:-not configured}
Access:   $([[ "${CLOUDINIT_ACCESS_MODE:-}" == "console" ]] && echo "Proxmox console root auto-login (SSH disabled)" || echo "${CLOUDINIT_ACCESS_MODE:-not configured}")
Network:  ${network_summary}
DNS:      ${dns_summary}

SSH Access:
  ${ssh_summary}

Delete this file after noting the credentials:
  rm -f ${CLOUDINIT_CRED_FILE}
EOF
  chmod 600 "$CLOUDINIT_CRED_FILE"
  export CLOUDINIT_CRED_FILE CLOUDINIT_PASSWORD
}

ubuntu_cleanup_cloud_init() {
  if [[ -n "${CLOUDINIT_SSH_KEYS_TEMP:-}" ]]; then
    rm -f "$CLOUDINIT_SSH_KEYS_TEMP" 2>/dev/null || true
  fi
  if [[ -n "${CLOUDINIT_HOST_KEY_FILE:-}" ]]; then
    rm -f "$CLOUDINIT_HOST_KEY_FILE" 2>/dev/null || true
  fi
  unset CLOUDINIT_SSH_KEYS_TEMP CLOUDINIT_HOST_KEY_FILE
}

ubuntu_display_cloud_init_info() {
  if [[ "${CLOUDINIT_ENABLE:-no}" == "yes" ]]; then
    local access_mode="${CLOUDINIT_ACCESS_MODE:-password}"
    local access_summary
    case "$access_mode" in
    ssh-key) access_summary="SSH key authentication" ;;
    password) access_summary="password authentication" ;;
    console) access_summary="Proxmox console root auto-login (SSH disabled)" ;;
    *) access_summary="not configured" ;;
    esac
    echo -e "Cloud-Init configured for user ${CLOUDINIT_USER}.\n
Password: ${CLOUDINIT_PASSWORD:-not configured}\n
Access: ${access_summary}\n
SSH key authentication: $([ -n "${CLOUDINIT_SSH_KEYS:-}" ] && echo configured || echo not configured)\n
SSH password authentication: $([ "${CLOUDINIT_SSH_PWAUTH:-no}" = "yes" ] && echo enabled || echo disabled)\n
Credentials: ${CLOUDINIT_CRED_FILE:-not created}\n
More info at https://github.com/community-scripts/ProxmoxVED/discussions/272 \n"
  else
    echo -e "Cloud-Init was not configured.\n
Console auto-login is enabled for root.\n
More info at https://github.com/community-scripts/ProxmoxVED/discussions/272 \n"
  fi
}

export -f ubuntu_validate_cloud_init_user ubuntu_validate_ssh_key_file \
  ubuntu_vmid_has_storage_volume ubuntu_get_valid_nextid ubuntu_configure_storage_layout \
  ubuntu_select_host_ssh_keys \
  ubuntu_normalize_ssh_key_file ubuntu_discover_host_ssh_keys \
  ubuntu_configure_ssh_keys ubuntu_configure_cloud_init_credentials \
  ubuntu_configure_cloud_init_default ubuntu_configure_cloud_init_advanced \
  ubuntu_ensure_virt_customize ubuntu_configure_image_access \
  ubuntu_setup_cloud_init ubuntu_cleanup_cloud_init ubuntu_display_cloud_init_info
